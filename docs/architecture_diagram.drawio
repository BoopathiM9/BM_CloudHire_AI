        <mxCell id="leg_col1" value="&lt;b&gt;❶ User Access:&lt;/b&gt; Recruiter opens BM CloudHire AI React SPA hosted on AWS Amplify via CloudFront CDN edge.&lt;br&gt;&lt;b&gt;❷ Direct S3 Upload:&lt;/b&gt; Client requests Presigned URL and uploads resume binary directly to private Amazon S3 bucket (bypassing 10MB API Gateway/Lambda limits)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;color:#334155;spacingLeft=15;" vertex="1" parent="leg_box">
          <mxGeometry x="0" y="32" width="680" height="50" as="geometry" />
        </mxCell>
        <mxCell id="leg_col2" value="&lt;b&gt;❸ API Gateway Dispatch:&lt;/b&gt; Browser calls REST endpoints (/resumes/process, /jobs, /ranking, /assignments).&lt;br&gt;&lt;b&gt;❹ Serverless Ingestion:&lt;/b&gt; ResumeProcessingLambda extracts text (pypdf/docx) &amp;amp; computes SHA-256 deduplication hash." style="text;html=1;align=left;verticalAlign=top;fontSize=11;color:#334155;spacingLeft=15;" vertex="1" parent="leg_box">
          <mxGeometry x="0" y="85" width="680" height="50" as="geometry" />
        </mxCell>

        <mxCell id="leg_col3" value="&lt;b&gt;❺ Amazon Bedrock Grounding:&lt;/b&gt; Nova Micro model extracts structured skills and evidence against S3 competency taxonomy.&lt;br&gt;&lt;b&gt;❻ Candidate Ranking &amp;amp; Strict Exclusion:&lt;/b&gt; Lambda queries DynamoDB GSI1 for 'STATUS#AVAILABLE', calculates 100-pt rubric, and executes atomic conditional write (Condition: status='AVAILABLE') upon assignment confirmation." style="text;html=1;align=left;verticalAlign=top;fontSize=11;color:#334155;spacingLeft=15;" vertex="1" parent="leg_box">
          <mxGeometry x="700" y="32" width="680" height="100" as="geometry" />
        </mxCell>

