        <mxCell id="card_step_1_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;" value="" vertex="1">
          <mxGeometry height="190" width="924" x="40" y="815" as="geometry" />
        </mxCell>
        <mxCell id="card_step_1_2_txt" parent="card_step_1_2" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Tier 1: Access &amp;amp; Direct S3 Upload&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;margin:6px 0;border:0;border-top:1px solid #E2E8F0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#334155;line-height:1.5;&quot;&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;❶ User Access:&lt;/b&gt; Recruiter opens BM CloudHire React SPA hosted on AWS Amplify via CloudFront global CDN edge network.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;❷ Direct S3 Upload:&lt;/b&gt; Client requests Presigned URL and uploads resume PDF/DOCX binary directly to private Amazon S3 bucket (bypassing 10MB API Gateway/Lambda limits).&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="924" x="9" y="10" as="geometry" />
        </mxCell>
        <mxCell id="card_step_3_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;" value="" vertex="1">
          <mxGeometry height="190" width="868" x="53" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="card_step_3_4_txt" parent="card_step_3_4" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Tier 2: Ingestion &amp;amp; Processing&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;margin:6px 0;border:0;border-top:1px solid #E2E8F0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#334155;line-height:1.5;&quot;&gt;&lt;b style=&quot;color:#7E22CE;&quot;&gt;❸ API Gateway Dispatch:&lt;/b&gt; Browser issues REST calls (&lt;code&gt;/resumes/process&lt;/code&gt;, &lt;code&gt;/jobs&lt;/code&gt;, &lt;code&gt;/ranking&lt;/code&gt;, &lt;code&gt;/assignments&lt;/code&gt;) with CORS handling.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#C2410C;&quot;&gt;❹ Serverless Parsing:&lt;/b&gt; ResumeProcessingLambda extracts text (PyPDF/DOCX) and computes SHA-256 hash for 100% duplicate resume detection.&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="868" as="geometry" />
        </mxCell>
