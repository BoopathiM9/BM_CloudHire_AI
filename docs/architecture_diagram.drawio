        <mxCell id="leg_title" value="&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Workflow Execution Steps (AWS Documentation Pattern):&lt;/b&gt;" style="text;html=1;verticalAlign=middle;align=left;spacingLeft=15;" vertex="1" parent="leg_box">
