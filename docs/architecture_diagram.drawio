          <mxGeometry height="190" width="985" x="72" y="1231" as="geometry" />
        </mxCell>
        <mxCell id="card_step_5_6_txt" parent="card_step_5_6" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Tier 3: Evaluation &amp;amp; Exclusion Rule&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;margin:6px 0;border:0;border-top:1px solid #E2E8F0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#334155;line-height:1.5;&quot;&gt;&lt;b style=&quot;color:#0F766E;&quot;&gt;❺ Bedrock Grounding:&lt;/b&gt; Amazon Bedrock (Nova Micro) extracts structured technical competencies grounded in S3 taxonomy.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#3730A3;&quot;&gt;❻ Ranking &amp;amp; Strict Exclusion:&lt;/b&gt; Lambda calculates deterministic 100-pt rubric. On confirmation, executes atomic conditional write (&lt;code&gt;status=&#39;AVAILABLE&#39;&lt;/code&gt;) to exclude candidate from future jobs.&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="985" as="geometry" />
